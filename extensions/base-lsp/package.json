{
  "name": "base-lsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A compact, safe Language Server Protocol toolbox for Pi",
  "keywords": ["pi-package", "pi-extension", "lsp"],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:smoke": "vitest run test/smoke",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ignore": "7.0.6",
    "vscode-jsonrpc": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "typescript-language-server": "5.3.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
